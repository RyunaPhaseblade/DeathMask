        }
      },
      {
        "when": "lost",
        "model": {
          "type": "minecraft:model",
          "model": "quantumdeath:item/shikigami_amulet_lost"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "quantumdeath:item/shikigami_amulet_empty"
    }
  }
